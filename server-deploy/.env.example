ENVIRONMENT=production
POSTGRES_DB=beyondcomfort
POSTGRES_USER=beyondcomfort
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
DATABASE_URL=postgresql+psycopg://beyondcomfort:replace-with-the-same-password@db:5432/beyondcomfort
JWT_SECRET=replace-with-at-least-32-random-bytes
SESSION_HOURS=168
COOKIE_SECURE=true
COOKIE_DOMAIN=
CONSENT_VERSION=pilot-v1
MAX_SESSION_PAYLOAD_BYTES=524288
# Comma-separated researcher account names allowed to assign AB/BA order and switch dates.
STUDY_ADMIN_USERNAMES=researcher-account-name
DEEPSEEK_API_KEY=replace-with-the-real-server-side-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45
# One isolated failure affects only that request. Three availability failures inside 30 seconds
# open the circuit; after 5 seconds exactly one half-open probe is allowed.
DEEPSEEK_FAILURE_THRESHOLD=3
DEEPSEEK_FAILURE_WINDOW_SECONDS=30
DEEPSEEK_HALF_OPEN_AFTER_SECONDS=5
DEEPSEEK_MAX_CONCURRENCY=6
DEEPSEEK_QUEUE_TIMEOUT_SECONDS=20
# Shared async HTTP connection pool for all Planner/Writer/Critic provider calls.
PROVIDER_HTTP_MAX_CONNECTIONS=24
PROVIDER_HTTP_MAX_KEEPALIVE_CONNECTIONS=12
PROVIDER_HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# Agent pipeline. DeepSeek is preferred for every role; OpenAI is an optional fallback.
AGENT_ENABLED=true
AGENT_CRITIC_ENABLED=true

# Leave empty for a DeepSeek-only deployment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_FAILURE_COOLDOWN_SECONDS=60

# Optional role-specific models. Leave unset to use DEEPSEEK_MODEL / OPENAI_MODEL.
DEEPSEEK_PLANNER_MODEL=deepseek-v4-pro
DEEPSEEK_WRITER_MODEL=deepseek-v4-pro
DEEPSEEK_CRITIC_MODEL=deepseek-v4-flash
DEEPSEEK_PLANNER_THINKING=enabled
DEEPSEEK_WRITER_THINKING=disabled
DEEPSEEK_CRITIC_THINKING=disabled
DEEPSEEK_PLANNER_REASONING_EFFORT=high
DEEPSEEK_WRITER_REASONING_EFFORT=high
DEEPSEEK_CRITIC_REASONING_EFFORT=high
# OPENAI_PLANNER_MODEL=gpt-5-mini
# OPENAI_WRITER_MODEL=gpt-5-mini
# OPENAI_CRITIC_MODEL=gpt-5-mini
